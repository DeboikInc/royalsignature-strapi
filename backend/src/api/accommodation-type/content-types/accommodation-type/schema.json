{
  "kind": "collectionType",
  "collectionName": "accommodation_types",
  "info": {
    "singularName": "accommodation-type",
    "pluralName": "accommodation-types",
    "displayName": "Accommodation Type"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "description": { "type": "richtext" },
    "excerpt": { "type": "text" },
    "property_type": { "type": "enumeration", "enum": ["apartment", "serviced-apartment", "hotel-room"], "default": "apartment" },
    "featured": { "type": "boolean", "default": false },
    "address_line1": { "type": "string" },
    "city": { "type": "string" },
    "state": { "type": "string" },
    "country": { "type": "string", "default": "Nigeria" },
    "latitude": { "type": "decimal", "min": -90, "max": 90 },
    "longitude": { "type": "decimal", "min": -180, "max": 180 },
    "adults": { "type": "integer", "min": 0 },
    "children": { "type": "integer", "min": 0 },
    "base_adults": { "type": "integer", "min": 0 },
    "base_children": { "type": "integer", "min": 0 },
    "bedrooms": { "type": "integer", "min": 0, "default": 0 },
    "beds": { "type": "integer", "min": 1, "default": 1 },
    "bathrooms": { "type": "decimal", "min": 0, "default": 1 },
    "bed_type": { "type": "string" },
    "size": { "type": "integer", "min": 0 },
    "view": { "type": "string" },
    "check_in_instructions": { "type": "text" },
    "check_out_instructions": { "type": "text" },
    "house_rules": { "type": "text" },
    "cancellation_policy": { "type": "text" },
    "minimum_nights": { "type": "integer", "min": 1, "default": 1 },
    "maximum_nights": { "type": "integer", "min": 1 },
    "seo_title": { "type": "string" },
    "seo_description": { "type": "text" },
    "services": { "type": "relation", "relation": "manyToMany", "target": "api::service.service", "inversedBy": "accommodation_types" },
    "categories": { "type": "relation", "relation": "manyToMany", "target": "api::category.category", "inversedBy": "accommodation_types" },
    "tags": { "type": "relation", "relation": "manyToMany", "target": "api::tag.tag", "inversedBy": "accommodation_types" },
    "amenities": { "type": "relation", "relation": "manyToMany", "target": "api::amenity.amenity", "inversedBy": "accommodation_types" },
    "cover_image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "images": { "type": "media", "multiple": true, "allowedTypes": ["images"] },
    "social_image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "attributes": { "type": "json" },
    "wp_id": { "type": "integer", "unique": true },
    "seed_key": { "type": "string", "unique": true },
    "rates": { "type": "relation", "relation": "oneToMany", "target": "api::rate.rate", "mappedBy": "accommodation_type" },
    "accommodations": { "type": "relation", "relation": "oneToMany", "target": "api::accommodation.accommodation", "mappedBy": "accommodation_type" },
    "reviews": { "type": "relation", "relation": "oneToMany", "target": "api::review.review", "mappedBy": "accommodation_type" }
  }
}