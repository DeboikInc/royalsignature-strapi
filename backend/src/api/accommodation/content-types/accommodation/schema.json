{
  "kind": "collectionType",
  "collectionName": "accommodations",
  "info": {
    "singularName": "accommodation",
    "pluralName": "accommodations",
    "displayName": "Accommodation Unit"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "name": { "type": "string", "required": true },
    "code": { "type": "string", "unique": true },
    "seed_key": { "type": "string", "unique": true },
    "unit_status": { "type": "enumeration", "enum": ["active", "inactive"], "default": "active" },
    "wp_id": { "type": "integer", "unique": true },
    "accommodation_type": { "type": "relation", "relation": "manyToOne", "target": "api::accommodation-type.accommodation-type", "inversedBy": "accommodations" },
    "bookings": { "type": "relation", "relation": "oneToMany", "target": "api::booking.booking", "mappedBy": "accommodation" },
    "availability_blocks": { "type": "relation", "relation": "oneToMany", "target": "api::availability-block.availability-block", "mappedBy": "accommodation" }
  }
}