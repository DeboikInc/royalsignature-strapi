# Server-only Strapi API origin; do not add /api.
STRAPI_URL=http://127.0.0.1:1437
STRAPI_API_TOKEN=replace_with_server_only_token
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:1437

# Public image base URL; safe to expose in browser requests.
NEXT_PUBLIC_STRAPI_MEDIA_URL=http://127.0.0.1:1437

# Local Docker development values. Use .env.local, never production passwords.
MARIADB_DATABASE=royal_signature_booking
MARIADB_USER=royal_signature_app
MARIADB_PASSWORD=replace_with_local_dev_password
MARIADB_ROOT_PASSWORD=replace_with_local_root_password
MARIADB_PORT=3317
STRAPI_PORT=1437
APP_KEYS=replace_with_key_one,replace_with_key_two,replace_with_key_three,replace_with_key_four
API_TOKEN_SALT=replace_with_random_secret
ADMIN_JWT_SECRET=replace_with_random_secret
TRANSFER_TOKEN_SALT=replace_with_random_secret
JWT_SECRET=replace_with_random_secret
ENCRYPTION_KEY=replace_with_random_secret
INTERNAL_WEBHOOK_SECRET=replace_with_random_secret

# Server-only application and payment configuration.
APP_BASE_URL=http://localhost:3100
PAYMENT_MODE=test
PAYMENT_PROVIDER=paystack
PAYMENT_PUBLIC_KEY=replace_with_paystack_test_public_key
PAYMENT_SECRET_KEY=replace_with_paystack_test_secret_key

